# Clerk (https://dashboard.clerk.com) — identity only. Native apps read the same
# publishable key as SETCATCHER_CLERK_PUBLISHABLE_KEY (env or Info.plist).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Supabase (service role for server routes only — never expose to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public account / marketing URL (production: https://beatrevival.com)
NEXT_PUBLIC_ACCOUNT_URL=http://localhost:3000
